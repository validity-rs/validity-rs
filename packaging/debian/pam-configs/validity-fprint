Name: Fingerprint authentication, password first on LightDM (validity-rs)
Default: no
Priority: 260
Conflicts: fprintd
Auth-Type: Primary
Auth:
	[success=ignore default=2]	pam_succeed_if.so quiet service = lightdm
	[success=end default=ignore]	pam_unix.so nullok
	[success=end default=die]	pam_validity.so max-tries=1 timeout=30 confirm
	[success=end default=ignore]	pam_validity.so max-tries=1 timeout=10
