# Debian 13 (trixie) packaging: build the .deb and test it (ci/packages/run.sh).
#
#   build   the Rust toolchain of Dockerfile.debian (same pinned image),
#           cargo-deb, lintian, and the APT repository tools. Builds run in it
#           with --network none, from the vendored source tarball.
#   test    a plain trixie with systemd as PID 1 and what the package works
#           with (fprintd, polkitd, the D-Bus system bus), preinstalled so that
#           the cycle can check that removing the package leaves the system as
#           it found it. The package itself is installed by the cycle.
#   apt-client  a clean trixie with systemd as PID 1 and its system bus, nothing
#           else: the APT test installs everything from the repositories.
#
# Images pinned by digest; Renovate proposes the bumps.

FROM rust:1.99.1-trixie@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS build

# Keep in step with docs/packaging.md. cargo install --locked builds the
# release's own Cargo.lock, every crate checked against its crates.io checksum.
ARG CARGO_DEB_VERSION=3.8.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        apt-utils \
        dpkg-dev \
        gnupg \
        lintian \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install --locked cargo-deb --version "$CARGO_DEB_VERSION" \
    && rm -rf /usr/local/cargo/registry \
    && rustc --version && cargo deb --version && lintian --version \
    && apt-ftparchive --version | head -1 && gpg --version | head -1

WORKDIR /build
CMD ["/bin/bash"]

FROM debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308 AS test

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dbus \
        fprintd \
        polkitd \
        systemd \
        systemd-sysv \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W fprintd polkitd dbus systemd curl

# The base image forbids service actions in maintainer scripts (exit 101); the
# cycle needs them to run as they do on a real system.
RUN rm /usr/sbin/policy-rc.d

STOPSIGNAL SIGRTMIN+3
# Never let systemd in a test container touch a console (defence in depth: the
# container has no host devices anyway).
RUN systemctl mask getty.target console-getty.service getty@tty1.service \
        serial-getty@ttyS0.service systemd-logind.service systemd-vconsole-setup.service
# Docker mounts the container's own cgroup tree (private cgroup namespace)
# read-only unless --privileged, which the tests never use; systemd needs it
# writable. Only that namespace is remounted: the host's tree is not visible.
CMD ["/bin/sh", "-c", "mount -o remount,rw /sys/fs/cgroup && exec /usr/lib/systemd/systemd"]

FROM debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308 AS apt-client

# The system bus too: on a real machine it runs from boot, and a bus installed
# after boot (as a dependency) is not started by its package.
RUN apt-get update \
    && apt-get install -y --no-install-recommends dbus systemd systemd-sysv \
    && rm -rf /var/lib/apt/lists/*

# As in the test stage: maintainer scripts run their service actions.
RUN rm /usr/sbin/policy-rc.d

STOPSIGNAL SIGRTMIN+3
# Never let systemd in a test container touch a console (defence in depth: the
# container has no host devices anyway).
RUN systemctl mask getty.target console-getty.service getty@tty1.service \
        serial-getty@ttyS0.service systemd-logind.service systemd-vconsole-setup.service
# Docker mounts the container's own cgroup tree (private cgroup namespace)
# read-only unless --privileged, which the tests never use; systemd needs it
# writable. Only that namespace is remounted: the host's tree is not visible.
CMD ["/bin/sh", "-c", "mount -o remount,rw /sys/fs/cgroup && exec /usr/lib/systemd/systemd"]
